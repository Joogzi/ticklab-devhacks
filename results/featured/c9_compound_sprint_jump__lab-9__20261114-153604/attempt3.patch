+def air_input_vector(xxa: float, zza: float, speed: float, yaw: float):
+    """Single-precision variant of input_vector for airborne movement."""
+    lsq = fadd(fmul(xxa, xxa), fmul(zza, zza))
+    if lsq < 1.0e-7:
+        return 0.0, 0.0
+    f = speed
+    if lsq > 1.0:
+        f = fdiv(speed, fsqrt(lsq))
+    x, z = fmul(xxa, f), fmul(zza, f)
+    r = fmul(yaw, DEG_TO_RAD_F)
+    s, c = mth_sin(r), mth_cos(r)
+    dx = fadd(fmul(x, c), -fmul(z, s))
+    dz = fadd(fmul(z, c), fmul(x, s))
+    return dx, dz
+
